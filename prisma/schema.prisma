generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ENTREPRENEUR
  PME
  ONG
  ADMIN
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  role             Role
  firstName        String?
  lastName         String?
  organizationName String?
  logoUrl          String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}