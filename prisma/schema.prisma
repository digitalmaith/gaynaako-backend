generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum RoleUtilisateur {
  ENTREPRENEUR
  PME
  ONG
  ADMINISTRATEUR
}

enum StatutUtilisateur {
  EN_ATTENTE
  ACTIF
  SUSPENDU
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum TypeOpportunite {
  FINANCEMENT
  SUBVENTION
  APPEL_OFFRE
  CONCOURS
  PROGRAMME_ACCELERATION
}

enum StatutCandidature {
  BROUILLON
  SOUMISE
  EN_COURS
  ACCEPTEE
  REJETEE
}

enum TypeEmetteur {
  SITE_WEB
  API
  RESEAU_SOCIAL
  PORTAIL_INSTITUTIONNEL
}

enum StatutEmetteur {
  ACTIF
  INACTIF
}

enum CanalNotification {
  EMAIL
  WHATSAPP
}

enum Expediteur {
  UTILISATEUR
  BOT
}

enum OrigineOpportunite {
  MANUELLE
  IA
}

enum TypeDocument {
  CV
  PIECE_IDENTITE
  REGISTRE_COMMERCE
  NINEA
  STATUTS_ENTREPRISE
  ATTESTATION_FISCALE
  ATTESTATION_SOCIALE
  JUSTIFICATIF_DOMICILE
  ATTESTATION
  AUTRE
}

enum CycleFacturation {
  MENSUEL
  ANNUEL
}

enum StatutAbonnement {
  EN_ATTENTE
  ACTIF
  EXPIRE
  ANNULE
  ECHEC_PAIEMENT
}

enum StatutTransaction {
  EN_ATTENTE
  REUSSIE
  ECHOUEE
  REMBOURSEE
}

enum FournisseurPaiement {
  WAVE
  ORANGE_MONEY
}

// ============================================================
// INSCRIPTION + OTP
// ============================================================

model RefreshToken {
  id            String      @id @default(uuid())
  tokenHash     String      @unique
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revoked       Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([utilisateurId])
  @@map("refresh_tokens")
}

model PendingRegistration {
  id            String          @id @default(uuid())
  email         String          @unique
  nom           String
  prenom        String
  motDePasse    String
  role          RoleUtilisateur
  donneesProfil Json
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("pending_registrations")
}

model OtpVerification {
  id        String     @id @default(uuid())
  email     String
  codeHash  String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  consumed  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_verifications")
}

// ============================================================
// UTILISATEUR + profils
// ============================================================

model Utilisateur {
  id           String            @id @default(uuid())
  email        String            @unique
  motDePasse   String
  nom          String
  prenom       String
  role         RoleUtilisateur
  statut       StatutUtilisateur @default(ACTIF)
  dateCreation DateTime          @default(now())
  supprimeLe   DateTime?

  entrepreneur   EntrepreneurProfile?
  pme            PmeProfile?
  ong            OngProfile?
  administrateur AdministrateurProfile?

  candidatures    Candidature[]
  favoris         Favori[]
  recommandations Recommandation[]
  conversations   ChatbotConversation[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  documents       DocumentUtilisateur[]
  abonnements     Abonnement[]

  @@map("utilisateurs")
}

model EntrepreneurProfile {
  id            String      @id @default(uuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  secteurId String
  secteur   Secteur @relation(fields: [secteurId], references: [id])

  paysId String
  pays   Pays   @relation(fields: [paysId], references: [id])

  domaineExpertise String
  objectifs        String? @db.Text

  @@map("entrepreneur_profiles")
}

model PmeProfile {
  id            String      @id @default(uuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  nomEntreprise String
  logoUrl       String?

  secteurs Secteur[]

  @@map("pme_profiles")
}

model OngProfile {
  id              String      @id @default(uuid())
  utilisateurId   String      @unique
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  nomOrganisation String
  mission         String?     @db.Text
  logoUrl         String?

  domainesIntervention DomaineIntervention[]

  @@map("ong_profiles")
}

model AdministrateurProfile {
  id            String      @id @default(uuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  niveauAcces   String      @default("STANDARD")

  opportunitesGerees Opportunite[]     @relation("AdminGereOpportunite")
  emetteurs          Emetteur[]
  journaux           JournalActivite[]

  @@map("administrateur_profiles")
}

// ============================================================
// TABLES PIVOT (remplacent String[] Postgres)
// ============================================================





// ============================================================
// RÉFÉRENTIELS
// ============================================================

model Secteur {
  id   String @id @default(uuid())
  nom  String @unique

  opportunites  Opportunite[]
  entrepreneurs EntrepreneurProfile[]
  pmes          PmeProfile[]

  @@map("secteurs")
}

model Pays {
  id   String  @id @default(uuid())
  nom  String  @unique
  code String? @unique

  entrepreneurs EntrepreneurProfile[]

  @@map("pays")
}

model DomaineIntervention {
  id   String @id @default(uuid())
  nom  String @unique

  ongs OngProfile[]

  @@map("domaines_intervention")
}

// ============================================================
// OPPORTUNITÉS & ÉMETTEURS
// ============================================================

model Emetteur {
  id                String         @id @default(uuid())
  nom               String
  url               String         @db.Text
  type              TypeEmetteur
  frequenceCollecte String
  dernierScan       DateTime?
  statut            StatutEmetteur @default(ACTIF)

  administrateurId String
  administrateur   AdministrateurProfile @relation(fields: [administrateurId], references: [id])

  opportunites Opportunite[]

  @@map("emetteurs")
}

model Opportunite {
  id                  String             @id @default(uuid())
  externalId          String?            @unique
  titre               String
  description         String             @db.Text
  type                TypeOpportunite
  pays                String
  dateLimite          DateTime
  criteresEligibilite String?            @db.Text
  origine             OrigineOpportunite @default(MANUELLE)
  dateCreation        DateTime           @default(now())
  supprimeLe          DateTime?

  secteurId String
  secteur   Secteur @relation(fields: [secteurId], references: [id])

  emetteurId String?
  emetteur   Emetteur? @relation(fields: [emetteurId], references: [id])

  administrateurId String?
  administrateur   AdministrateurProfile? @relation("AdminGereOpportunite", fields: [administrateurId], references: [id])

  candidatures    Candidature[]
  favoris         Favori[]
  recommandations Recommandation[]

  @@map("opportunites")
}

// ============================================================
// INTERACTIONS
// ============================================================

model Candidature {
  id             String            @id @default(uuid())
  statut         StatutCandidature @default(BROUILLON)
  dateSoumission DateTime?
  dateCreation   DateTime          @default(now())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  opportuniteId String
  opportunite   Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, opportuniteId])
  @@map("candidatures")
}

model Favori {
  id        String   @id @default(uuid())
  dateAjout DateTime @default(now())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  opportuniteId String
  opportunite   Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, opportuniteId])
  @@map("favoris")
}

model Recommandation {
  id              String   @id @default(uuid())
  scorePertinence Float
  dateGeneration  DateTime @default(now())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  opportuniteId String
  opportunite   Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("recommandations")
}

model ChatbotConversation {
  id             String   @id @default(uuid())
  utilisateurId  String
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  titre          String   @default("Nouvelle conversation")
  nombreMessages Int      @default(0)
  dateDebut      DateTime @default(now())
  dateMaj        DateTime @updatedAt

  messages ChatMessage[]

  @@index([utilisateurId])
  @@map("chatbot_conversations")
}

model ChatMessage {
  id         String     @id @default(uuid())
  contenu    String     @db.Text
  expediteur Expediteur
  horodatage DateTime   @default(now())

  conversationId String
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Notification {
  id        String            @id @default(uuid())
  canal     CanalNotification
  contenu   String            @db.Text
  dateEnvoi DateTime          @default(now())
  envoyee   Boolean           @default(false)

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================================
// ADMINISTRATION
// ============================================================

model JournalActivite {
  id        String   @id @default(uuid())
  action    String
  dateHeure DateTime @default(now())

  administrateurId String
  administrateur   AdministrateurProfile @relation(fields: [administrateurId], references: [id])

  @@map("journaux_activite")
}

// ============================================================
// DOCUMENTS
// ============================================================

model DocumentUtilisateur {
  id             String       @id @default(uuid())
  utilisateurId  String
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type           TypeDocument
  libelle        String
  publicId       String
  resourceType   String
  nomFichier     String
  mimeType       String
  tailleOctets   Int
  dateExpiration DateTime?
  dateAjout      DateTime     @default(now())

  @@index([utilisateurId])
  @@map("documents_utilisateur")
}

// ============================================================
// ABONNEMENTS & PAIEMENTS
// ============================================================

model Plan {
  id             String   @id @default(uuid())
  nom            String   @unique
  description    String?  @db.Text
  prixMensuel    Int
  prixAnnuel     Int
  actif          Boolean  @default(true)
  ordreAffichage Int      @default(0)
  dateCreation   DateTime @default(now())

  fonctionnalites PlanFonctionnalite[]
  abonnements     Abonnement[]

  @@map("plans")
}

model PlanFonctionnalite {
  id     String @id @default(uuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  cle    String
  valeur String

  @@unique([planId, cle])
  @@index([planId])
  @@map("plan_fonctionnalites")
}

model Abonnement {
  id                 String           @id @default(uuid())
  utilisateurId      String
  utilisateur        Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan             @relation(fields: [planId], references: [id])
  cycle              CycleFacturation
  statut             StatutAbonnement @default(EN_ATTENTE)
  dateDebut          DateTime?
  dateFin            DateTime?
  renouvellementAuto Boolean          @default(true)
  dateCreation       DateTime         @default(now())
  supprimeLe         DateTime?

  transactions Transaction[]

  @@index([utilisateurId])
  @@index([planId])
  @@index([statut])
  @@map("abonnements")
}

model Transaction {
  id               String              @id @default(uuid())
  abonnementId     String
  abonnement       Abonnement          @relation(fields: [abonnementId], references: [id], onDelete: Cascade)
  fournisseur      FournisseurPaiement
  referenceExterne String?             @unique
  montant          Int
  statut           StatutTransaction   @default(EN_ATTENTE)
  dateCreation     DateTime            @default(now())
  dateConfirmation DateTime?
  metadonnees      Json?

  @@index([abonnementId])
  @@index([statut])
  @@map("transactions")
}
