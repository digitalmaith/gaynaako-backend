generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum RoleUtilisateur {
  ENTREPRENEUR
  PME
  ONG
  ADMINISTRATEUR
}

enum StatutUtilisateur {
  EN_ATTENTE
  ACTIF
  SUSPENDU
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum TypeOpportunite {
  FINANCEMENT
  SUBVENTION
  APPEL_OFFRE
  CONCOURS
  PROGRAMME_ACCELERATION
}

enum StatutCandidature {
  BROUILLON
  SOUMISE
  EN_COURS
  ACCEPTEE
  REJETEE
}

enum TypeEmetteur {
  SITE_WEB
  API
  RESEAU_SOCIAL
  PORTAIL_INSTITUTIONNEL
}

enum StatutEmetteur {
  ACTIF
  INACTIF
}

enum CanalNotification {
  EMAIL
  WHATSAPP
}

enum Expediteur {
  UTILISATEUR
  BOT
}

enum OrigineOpportunite {
  MANUELLE
  IA
}

enum TypeDocument {
  CV
  PIECE_IDENTITE
  REGISTRE_COMMERCE
  NINEA
  STATUTS_ENTREPRISE
  ATTESTATION_FISCALE
  ATTESTATION_SOCIALE
  JUSTIFICATIF_DOMICILE
  ATTESTATION
  AUTRE
}

// ============================================================
// AUTH
// ============================================================

model RefreshToken {
  id            String      @id @default(uuid())
  tokenHash     String      @unique
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revoked       Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([utilisateurId])
  @@map("refresh_tokens")
}

model PendingRegistration {
  id            String          @id @default(uuid())
  email         String          @unique
  nom           String
  prenom        String
  motDePasse    String
  role          RoleUtilisateur
  donneesProfil Json
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("pending_registrations")
}

model OtpVerification {
  id        String     @id @default(uuid())
  email     String
  codeHash  String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  consumed  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_verifications")
}

// ============================================================
// UTILISATEUR + profils 1-1
// ============================================================

model Utilisateur {
  id           String            @id @default(uuid())
  email        String            @unique
  motDePasse   String
  nom          String
  prenom       String
  role         RoleUtilisateur
  statut       StatutUtilisateur @default(ACTIF)
  dateCreation DateTime          @default(now())
  supprimeLe   DateTime?

  entrepreneur   EntrepreneurProfile?
  pme            PmeProfile?
  ong            OngProfile?
  administrateur AdministrateurProfile?

  candidatures    Candidature[]
  favoris         Favori[]
  recommandations Recommandation[]
  conversations   ChatbotConversation[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  documents       DocumentUtilisateur[]

  @@map("utilisateurs")
}

model EntrepreneurProfile {
  id            String      @id @default(uuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  secteurId String
  secteur   Secteur @relation(fields: [secteurId], references: [id])

  paysId String
  pays   Pays   @relation(fields: [paysId], references: [id])

  domaineExpertise String
  objectifs        String?

  @@map("entrepreneur_profiles")
}

model PmeProfile {
  id            String      @id @default(uuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  nomEntreprise String
  logoUrl       String?

  secteurs PmeProfileSecteur[]

  @@map("pme_profiles")
}

model OngProfile {
  id              String      @id @default(uuid())
  utilisateurId   String      @unique
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  nomOrganisation String
  mission         String?
  logoUrl         String?

  domainesIntervention OngProfileDomaine[]

  @@map("ong_profiles")
}

// Tables pivot (remplacent les String[] Postgres)
model PmeProfileSecteur {
  pmeProfileId String
  secteurId    String

  pmeProfile PmeProfile @relation(fields: [pmeProfileId], references: [id], onDelete: Cascade)
  secteur    Secteur    @relation(fields: [secteurId], references: [id], onDelete: Cascade)

  @@id([pmeProfileId, secteurId])
  @@map("pme_profile_secteurs")
}

model OngProfileDomaine {
  ongProfileId         String
  domaineInterventionId String

  ongProfile         OngProfile         @relation(fields: [ongProfileId], references: [id], onDelete: Cascade)
  domaineIntervention DomaineIntervention @relation(fields: [domaineInterventionId], references: [id], onDelete: Cascade)

  @@id([ongProfileId, domaineInterventionId])
  @@map("ong_profile_domaines")
}

model AdministrateurProfile {
  id            String      @id @default(uuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  niveauAcces   String      @default("STANDARD")

  opportunitesGerees Opportunite[]     @relation("AdminGereOpportunite")
  emetteurs          Emetteur[]
  journaux           JournalActivite[]

  @@map("administrateur_profiles")
}

// ============================================================
// RÉFÉRENTIELS
// ============================================================

model Secteur {
  id   String @id @default(uuid())
  nom  String @unique

  opportunites Opportunite[]

  entrepreneurs EntrepreneurProfile[]
  pmes          PmeProfileSecteur[]

  @@map("secteurs")
}

model Pays {
  id   String  @id @default(uuid())
  nom  String  @unique
  code String? @unique

  entrepreneurs EntrepreneurProfile[]

  @@map("pays")
}

model DomaineIntervention {
  id   String @id @default(uuid())
  nom  String @unique

  ongs OngProfileDomaine[]

  @@map("domaines_intervention")
}

// ============================================================
// OPPORTUNITÉS & ÉMETTEURS
// ============================================================

model Emetteur {
  id                String         @id @default(uuid())
  nom               String
  url               String         @db.Text
  type              TypeEmetteur
  frequenceCollecte String
  dernierScan       DateTime?
  statut            StatutEmetteur @default(ACTIF)

  administrateurId String
  administrateur   AdministrateurProfile @relation(fields: [administrateurId], references: [id])

  opportunites Opportunite[]

  @@map("emetteurs")
}

model Opportunite {
  id                  String             @id @default(uuid())
  externalId          String?            @unique
  titre               String
  description         String             @db.Text
  type                TypeOpportunite
  pays                String
  dateLimite          DateTime
  criteresEligibilite String?            @db.Text
  origine             OrigineOpportunite @default(MANUELLE)
  dateCreation        DateTime           @default(now())
  supprimeLe          DateTime?

  secteurId String
  secteur   Secteur @relation(fields: [secteurId], references: [id])

  emetteurId String?
  emetteur   Emetteur? @relation(fields: [emetteurId], references: [id])

  administrateurId String?
  administrateur   AdministrateurProfile? @relation("AdminGereOpportunite", fields: [administrateurId], references: [id])

  candidatures    Candidature[]
  favoris         Favori[]
  recommandations Recommandation[]

  @@map("opportunites")
}

// ============================================================
// INTERACTIONS
// ============================================================

model Candidature {
  id             String            @id @default(uuid())
  statut         StatutCandidature @default(BROUILLON)
  dateSoumission DateTime?
  dateCreation   DateTime          @default(now())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  opportuniteId String
  opportunite   Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, opportuniteId])
  @@map("candidatures")
}

model Favori {
  id        String   @id @default(uuid())
  dateAjout DateTime @default(now())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  opportuniteId String
  opportunite   Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, opportuniteId])
  @@map("favoris")
}

model Recommandation {
  id              String   @id @default(uuid())
  scorePertinence Float
  dateGeneration  DateTime @default(now())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  opportuniteId String
  opportunite   Opportunite @relation(fields: [opportuniteId], references: [id], onDelete: Cascade)

  @@map("recommandations")
}

model ChatbotConversation {
  id        String   @id @default(uuid())
  dateDebut DateTime @default(now())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@map("chatbot_conversations")
}

model ChatMessage {
  id         String     @id @default(uuid())
  contenu    String     @db.Text
  expediteur Expediteur
  horodatage DateTime   @default(now())

  conversationId String
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Notification {
  id        String            @id @default(uuid())
  canal     CanalNotification
  contenu   String            @db.Text
  dateEnvoi DateTime          @default(now())
  envoyee   Boolean           @default(false)

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model JournalActivite {
  id        String   @id @default(uuid())
  action    String
  dateHeure DateTime @default(now())

  administrateurId String
  administrateur   AdministrateurProfile @relation(fields: [administrateurId], references: [id])

  @@map("journaux_activite")
}

model DocumentUtilisateur {
  id            String       @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type          TypeDocument
  libelle       String
  url           String       @db.Text
  nomFichier    String
  mimeType      String
  tailleOctets  Int
  dateAjout     DateTime     @default(now())

  @@index([utilisateurId])
  @@map("documents_utilisateur")
}