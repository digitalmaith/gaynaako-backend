// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ENTREPRENEUR
  PME
  ONG
  ADMIN
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  role             Role
  firstName        String?
  lastName         String?
  organizationName String? // requis pour PME / ONG
  logoUrl          String? // requis pour PME / ONG (Cloudinary)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}
